{
  "name": "Zikroom — Blind test en ligne",
  "short_name": "Zikroom",
  "description": "Blind test musical en direct avec tes amis : devine l'artiste et le titre avant les autres.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#060408",
  "theme_color": "#060408",
  "lang": "fr",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "scope": "/",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  }
}
